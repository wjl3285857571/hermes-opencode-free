<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.hermes.ocbridge.refresh</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__DIR__/refresh-models.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__DIR__</string>

    <!-- Hourly: opencode delists models on its own schedule (ll-alpha-free vanished
         mid-session today), and the bridge reflects it immediately. Hourly is cheap
         enough to just always be current. -->
    <key>StartInterval</key>
    <integer>3600</integer>

    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>

    <key>StandardOutPath</key>
    <string>__DIR__/refresh.log</string>
    <key>StandardErrorPath</key>
    <string>__DIR__/refresh.log</string>
</dict>
</plist>
