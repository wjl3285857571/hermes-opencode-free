<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.hermes.ocbridge.bridge</string>

    <key>ProgramArguments</key>
    <array>
        <string>__NODE__</string>
        <string>__DIR__/bridge.mjs</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__DIR__</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PORT</key>
        <string>__BRIDGE_PORT__</string>
        <key>OPENCODE_UPSTREAM</key>
        <string>http://127.0.0.1:__SERVE_PORT__</string>
        <key>PATH</key>
        <string>__PATH__</string>
    </dict>

    <!-- Bridge waits for the serve half rather than crash-looping: opencode's startup
         and its rotating password can land after the bridge boots, and the bridge
         re-reads the password file per request, so a late start still self-heals. -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>

    <key>StandardOutPath</key>
    <string>__DIR__/bridge.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>__DIR__/bridge.stderr.log</string>
</dict>
</plist>
